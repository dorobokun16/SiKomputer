{
  "name": "sikomputer",
  "private": true,
  "version": "1.1.0",
  "sikomputer": {
    "versionCode": 2,
    "githubOwner": "dorobokun16",
    "githubRepo": "SiKomputer",
    "releaseNotes": [
      "Perbaikan tata letak responsif Mobile HP & modal Notepad",
      "Penambahan fitur Cek Pembaruan & Update otomatis via GitHub (PWA, .exe, .app, .apk)"
